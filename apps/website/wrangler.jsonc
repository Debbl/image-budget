{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "image-budget",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [
    {
      "pattern": "image-budget.aiwan.run",
      "custom_domain": true,
    },
  ],
}
